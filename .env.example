# Copia in .env prima di avviare il nodo: `cp .env.example .env`

# --- Tron (obbligatorie: senza queste il nodo non parte) ---
TRONGRIDAPIKEY=la-tua-api-key-trongrid
TRON_ADDRESS=il-tuo-indirizzo-tron

# --- Nodo (opzionali, questi sono i default) ---
# Dove viene persistita la catena fra un riavvio e l'altro.
CHAIN_PATH=data/chain.json
# Nome con cui questo nodo sigilla i blocchi. Entra nel blocco di genesi, quindi
# nodi che partono da zero con nomi diversi producono genesis diversi e non si
# sincronizzano: o condividono questo nome, o i nodi secondari adottano via sync
# la catena di chi l'ha creata (vedi INITIAL_AUTHORITIES).
AUTHORITY_NAME=blockrock
# Seed ed25519 con cui questo nodo firma, generato al primo avvio (permessi 0600).
# In una rete single-authority tutti i nodi condividono questo file. In una rete
# multi-authority ogni nodo tiene il proprio e si fa autorizzare dagli altri.
AUTHORITY_KEY_PATH=data/authority.key

# --- Monitoraggio (opzionale) ---
# L'ipotalamo valuta CPU, memoria, latenza ed errori e decide se serve piu'
# capacita' (hypertrophy), meno (atrophy) o nessun cambiamento (maintain).
# Il nodo non aziona niente da se': se questa variabile e' valorizzata, spedisce
# la decisione in POST JSON a questo indirizzo e sta a chi ascolta agire.
# Senza, le decisioni restano leggibili solo su GET /metabolism.
# La notifica parte solo quando la decisione CAMBIA, non a ogni ciclo.
# METABOLIC_WEBHOOK=http://localhost:9000/metabolismo

# --- Multi-authority (opzionale) ---
# Altre autorità autorizzate a sigillare, come coppie `nome:pubkey_hex`
# separate da virgola. La pubkey è un ed25519 da 32 byte in esadecimale.
# L'autorità locale (AUTHORITY_NAME) è sempre inclusa da sé.
#
# ATTENZIONE: questo valore viene letto SOLO quando la catena viene creata per
# la prima volta. Se `data/chain.json` esiste già viene ignorato in silenzio —
# aggiungerlo a un nodo già avviato non ha alcun effetto. Per cambiare il set
# di autorità su una catena esistente serve ripartire dalla genesi.
#
# La pubkey di un nodo si legge dal nodo stesso:
#   curl -s localhost:8000/accounts/$AUTHORITY_NAME | jq -r .public_key
#
# Una volta alla genesi, il set di autorità viaggia da solo: i nodi se lo
# scambiano insieme alla catena durante il sync.
#
# INITIAL_AUTHORITIES=alice:3b6a27bcceb6a42d62a3a8d02a6f0d73653215771de243a63ac048a18b59da29,bob:d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a
