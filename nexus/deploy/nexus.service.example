# Copiare in ~/.config/systemd/user/blockrock-nexus.service dopo aver adattato il percorso.
[Unit]
Description=Nexus - spazio personale BlockRock
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Documenti/VSCode/BlockRock/nexus
ExecStart=%h/Documenti/VSCode/BlockRock/nexus/server/.venv/bin/python -m server.run
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
